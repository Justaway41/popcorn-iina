{
  "name": "popcorn-iina",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.plugin.json && tsc --noEmit -p tsconfig.ui.json",
    "build": "bun run build:plugin && bun run build:ui",
    "package": "bun run clean && bun run build && zip -FSr xyz.brbc.popcorn.iinaplugin.iinaplgz Info.json assets dist ui",
    "build:plugin": "bun build src/plugin/main.ts src/plugin/global.ts --outdir dist --target=browser --format=iife",
    "build:ui": "bun build src/ui/sidebar.ts src/ui/preferences.ts --outdir ui/dist --target=browser --format=iife",
    "clean": "rm -rf dist ui/dist",
    "verify:root-info": "bun scripts/verify-root-info.js",
    "verify:built-client-version": "bun scripts/verify-built-client-version.js"
  },
  "devDependencies": {
    "iina-plugin-definition": "^0.99.3",
    "typescript": "^5.9.3"
  }
}
